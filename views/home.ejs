
<!DOCTYPE html>
<html lang="en">
<head>
    
    <%- include('./partials/head') %>
    <title>Blogers | Home</title>
    <style>
        body {
            background-color: #f5f7fb;
            font-family: Arial, sans-serif;
        }

        .hero-section {
            padding: 45px 0 30px;
        }

        .hero-section h1 {
            font-weight: 800;
        }

        .blog-card {
            height: 100%;
            border: none;
            border-radius: 14px;
            overflow: hidden;
            background: white;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .blog-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
        }

        .blog-cover {
            width: 100%;
            height: 220px;
            object-fit: cover;
            background-color: #e9ecef;
        }

        .blog-title {
            font-weight: 700;
            color: #212529;
        }

        .blog-description {
            color: #6c757d;
            line-height: 1.6;
        }

        .blog-author {
            font-size: 14px;
            color: #495057;
        }

        .blog-date {
            font-size: 13px;
            color: #868e96;
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
            background: white;
            border-radius: 14px;
        }
    </style>
</head>

<body>

    <!-- Existing navbar -->
    <%- include('partials/nav') %>

    <main class="container">

        <!-- Hero section -->
        <section class="hero-section">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>
                    <h1>Discover Stories</h1>
                    <p class="text-secondary mb-0">
                        Explore ideas, knowledge, and experiences from our community.
                    </p>
                </div>

                <% if (user) { %>
                    <a href="/blog/add-new" class="btn btn-primary">
                        + Write a Blog
                    </a>
                <% } else { %>
                    <a href="/signin" class="btn btn-primary">
                        Sign In to Write
                    </a>
                <% } %>

            </div>
        </section>

        <!-- Blog cards section -->
        <section class="pb-5">

            <h3 class="mb-4">Latest Blogs</h3>

            <% if (blogs && blogs.length > 0) { %>

                <div class="row g-4">

                    <% blogs.forEach(blog => { %>

                        <div class="col-12 col-md-6 col-lg-4">

                            <div class="card blog-card">

                                <!-- Cover image -->
                                <img
                                    src="<%= blog.coverImage || '/images/default-blog.jpg' %>"
                                    alt="<%= blog.title %>"
                                    class="blog-cover"
                                    loading="lazy"
                                    onerror="this.onerror=null; this.src='/images/default-blog.jpg';"
                                >

                                <div class="card-body d-flex flex-column">

                                    <!-- Blog title -->
                                    <h5 class="blog-title">
                                        <%= blog.title %>
                                    </h5>

                                    <!-- Blog preview -->
                                    <p class="blog-description">
                                        <%= blog.body.length > 140
                                            ? blog.body.substring(0, 140) + "..."
                                            : blog.body %>
                                    </p>

                                    <!-- Author metadata -->
                                    <div class="mt-auto pt-3 border-top">

                                        <div class="blog-author mb-1">
                                            <strong>Author:</strong>
                                            <%= blog.createdBy
                                                ? blog.createdBy.fullname
                                                : "Unknown Author" %>
                                        </div>

                                        <!-- Publication date -->
                                        <div class="blog-date">
                                            Published:
                                            <%= new Date(blog.createdAt).toLocaleDateString("en-IN", {
                                                day: "numeric",
                                                month: "short",
                                                year: "numeric"
                                            }) %>
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } else { %>

                <!-- Empty state when no blogs exist -->
                <div class="empty-state">

                    <h4>No blogs published yet</h4>

                    <p class="text-secondary">
                        Be the first to share your story with the community.
                    </p>

                    <% if (user) { %>
                        <a href="/blog/add-new" class="btn btn-primary">
                            Write Your First Blog
                        </a>
                    <% } else { %>
                        <a href="/signin" class="btn btn-primary">
                            Sign In to Get Started
                        </a>
                    <% } %>

                </div>

            <% } %>

        </section>

    </main>

