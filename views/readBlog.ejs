<%- include("partials/head") %>

<%- include("partials/nav") %>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Blog Image -->
            <img
                src="<%= blog.coverImage %>"
                alt="<%= blog.title %>"
                class="img-fluid rounded mb-4 w-100"
            >

            <!-- Blog Title -->
            <h1><%= blog.title %></h1>

            <!-- Author -->
            <p class="text-muted">
                Author:
                <%= blog.createdBy ? blog.createdBy.fullname : "Unknown" %>
            </p>

            <hr>

            <!-- Complete Blog Content -->
            <div class="blog-content">
                <p style="white-space: pre-wrap;"><%= blog.body %></p>
            </div>

            <!-- Back Button -->
            <a href="/" class="btn btn-secondary mt-4">
                Back to Home
            </a>

        </div>
    </div>
</div>

<%- include("partials/scripts") %>